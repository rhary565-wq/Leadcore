# Copy to .env and fill in. Never commit .env.

# ─── Supabase: LeadGen data project (service key stays on the server) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ─── Supabase: login project (YodSales). Leave blank if same as above ──
AUTH_SUPABASE_URL=
AUTH_SUPABASE_ANON_KEY=
# Comma-separated admin emails (Admin Portal access)
ADMIN_EMAILS=yodsalesth@gmail.com,harione@gmail.com
# false = skip login check (local demo only — never in production)
AUTH_REQUIRED=true

# ─── AI Assistant (Gemini) ───────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── HubSpot ─────────────────────────────────────────────
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PORTAL_ID=

# ─── Apify (default Google Maps engine) ──────────────────
APIFY_API_TOKEN=

# ─── Apollo ──────────────────────────────────────────────
APOLLO_API_KEY=

# ─── Self-hosted Google Maps engine (gosom, needs Docker) ─
SCRAPER_IMAGE=gosom/google-maps-scraper:latest
SCRAPER_DEPTH=10
SCRAPER_CONCURRENCY=4
SCRAPER_INACTIVITY=3m
SCRAPER_PROXIES=

# ─── Email (Resend) ──────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=
APPROVER_EMAIL=
SUPPORT_EMAIL=

# ─── Google Cloud Tasks (leave GCP_PROJECT_ID blank to run the queue locally)
GCP_PROJECT_ID=
GCP_REGION=asia-southeast1

# ─── App ─────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:3000
BACKEND_URL=
# Public URL Apollo calls for the email/phone webhook (usually the same as BACKEND_URL)
PUBLIC_BASE_URL=
INTERNAL_TOKEN=change-me-to-a-long-random-string
PORT=8080
