# Backend API (the unified Node backend)
VITE_API_URL=http://localhost:8080
# Supabase project users log in to (YodSales). Anon key only — never the service key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Optional: enable "Continue with Google" (configure Google provider in Supabase Auth first)
VITE_ENABLE_GOOGLE_LOGIN=false

# Skip the login page (LOCAL TESTING ONLY). Also set AUTH_REQUIRED=false in backend/.env
VITE_AUTH_DISABLED=false
